# Qualcomm QCC730 GPIO configuration options

config GPIO_QCC730
	bool "Qualcomm QCC730 GPIO driver"
	default y
	depends on DT_HAS_QCOM_QCC730_GPIO_ENABLED
	help
	  Enable support for the Qualcomm QCC730 GPIO controllers.

config GPIO_QCC730_INTERRUPT
	bool "Interrupt support for QCC730 GPIO driver"
	default y
	depends on GPIO_QCC730
	help
	  Enable interrupt support for QCC730 GPIO driver.
