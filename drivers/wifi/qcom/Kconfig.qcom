config WIFI_QCOM
	bool "Qcom wifi driver"
	select QWIFI
	select WIFI_USE_NATIVE_NETWORKING if NETWORKING
	select NET_L2_WIFI_MGMT if NETWORKING
	select NET_L2_ETHERNET_MGMT if NETWORKING && NET_L2_ETHERNET
	#default y
	default n

config WIFI_QCOM_AUTO_DHCPV4
	bool "Automatically starts DHCP4 negotiation"
	depends on WIFI_QCOM
	depends on NET_IPV4
	depends on NET_DHCPV4
	help
	  WiFi driver will automatically initiate DHCPV4 negotiation when connected.

config WIFI_SHELL_MAX_AP_STA
	int "Maximum number of APs and STAs that can be managed in Wi-Fi shell"
	default 4
