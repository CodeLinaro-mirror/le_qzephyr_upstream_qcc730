# Qualcomm QCC730 DMA configuration options

config DMA_QCC730
	bool "Qualcomm QCC730 DMA (DXE) driver"
	default y if DT_HAS_QCOM_QCC730_DXE_ENABLED
	select DMA
	help
	  Enable support for the Qualcomm QCC730 DMA (DXE) controller.
