# Qualcomm QCC730 UART configuration options

config UART_QCC730
	bool "Qualcomm QCC730 UART driver"
	default y
	# select SERIAL_SUPPORT_INTERRUPT
	depends on PINCTRL
	depends on DT_HAS_QCOM_QCC730_PINCTRL_ENABLED
	depends on SERIAL
	depends on DT_HAS_QCOM_QCC730_UART_ENABLED
	select RING_BUFFER
	depends on SOC_QCC730_HAS_UART_V2
	select BOARD_QCC730_UART_ENABLE
	select SERIAL_HAS_DRIVER
	select UART_QCC730_LL
	select UART_HAL
	help
	  Enable support for the Qualcomm QCC730 UART controllers.
