config SPI_QCC730
	bool "Qualcomm QCC730 SPI slave driver"
	default y
	depends on SPI
	depends on DT_HAS_QCOM_QCC730_SPI_ENABLED
	help
	  Enable support for the Qualcomm QCC730 SPI slave controller.
