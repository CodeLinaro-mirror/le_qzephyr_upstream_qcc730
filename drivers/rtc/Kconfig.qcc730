# Qualcomm QCC730 RTC configuration options

config RTC_QCC730
	bool "Qualcomm QCC730 RTC driver"
	default y if DT_HAS_QCOM_QCC730_RTC_ENABLED
	depends on RTC && COUNTER
	help
	  Enable support for the Qualcomm QCC730 RTC driver.

config RTC_QCC730_INIT_PRIORITY
	int "QCC730 RTC init priority"
	default 60
	depends on RTC_QCC730
	help
	  The priority of QCC730 RTC driver initialization.
	  Must be greater (later) than the qtimer/counter init priority.
