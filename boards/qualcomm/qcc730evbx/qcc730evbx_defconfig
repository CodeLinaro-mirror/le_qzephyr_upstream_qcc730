CONFIG_SYS_CLOCK_HW_CYCLES_PER_SEC=60000000
CONFIG_SYS_CLOCK_TICKS_PER_SEC=1000

CONFIG_HEAP_MEM_POOL_SIZE=262144

CONFIG_DRV_DUMMY=y
CONFIG_DRV_DUMMY_QCC730=y

# Execute from RAM
CONFIG_XIP=y

CONFIG_UART_QCC730=y
#for UART GPIO configurations
CONFIG_BOARD_QCC730_UART_GPIO_OPTION=3
CONFIG_QLIB_EARLY_PRINTK=y

# enable uart driver
CONFIG_SERIAL=y

# console
CONFIG_CONSOLE=y
CONFIG_UART_CONSOLE=y

CONFIG_LOG=y
CONFIG_LOG_MODE_MINIMAL=y

CONFIG_SHELL=y
CONFIG_SHELL_BACKENDS=y
CONFIG_SHELL_BACKEND_SERIAL=y

CONFIG_QWIFI=y
CONFIG_SOC_LOG_LEVEL_DBG=y

