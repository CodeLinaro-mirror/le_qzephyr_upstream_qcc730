#enable SERIAL
CONFIG_PINCTRL=y
CONFIG_CLOCK_CONTROL=y
CONFIG_SERIAL=y
CONFIG_CONSOLE=y
CONFIG_UART_CONSOLE=y
CONFIG_BOARD_QCC730_UART_GPIO_OPTION=1
CONFIG_UART_QCC730=y
CONFIG_QLIB_EARLY_PRINTK=y

CONFIG_LOG=y
CONFIG_LOG_MODE_MINIMAL=y

CONFIG_SHELL=y
CONFIG_SHELL_BACKENDS=y
CONFIG_SHELL_BACKEND_SERIAL=y

CONFIG_SOC_LOG_LEVEL_DBG=y
CONFIG_EXTRA_EXCEPTION_INFO=y

CONFIG_QCC730_BDF_FILE="mqm730x.bin"
CONFIG_QCC730_SBL_FILE="qcc730mx_sbl_HASHED.elf"
CONFIG_QCC730_PRG_FILE="qcc730mx_prg.elf"

CONFIG_FPU=y

# Flash driver configuration
CONFIG_FLASH=y
CONFIG_FLASH_QCC730=y
CONFIG_FLASH_QCC730_QSPI_QUAD_MODE=y

